{
  "name": "pal-arena-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "prettier --check src index.html vite.config.js && node scripts/check-syntax.mjs",
    "format": "prettier --write src index.html vite.config.js",
    "export:demo": "npm run build && node scripts/export-demo.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
